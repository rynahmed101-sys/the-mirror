# THE MIRROR — Environment Configuration Reference
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# For Local Development (SQLite):
DATABASE_DIALECT=sqlite
DATABASE_URL=./data/mirror.db

# For Production (Vercel + PostgreSQL / Neon):
# DATABASE_DIALECT=postgres
# DATABASE_URL=postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/mirror?sslmode=require

# -----------------------------------------------------------------------------
# AI PROVIDER CONFIGURATION
# Set AI_PROVIDER to exactly one of: ollama | llamacpp | openrouter | xai
# There is NO silent fallback. A misconfigured provider causes an explicit error.
# -----------------------------------------------------------------------------
AI_PROVIDER=openrouter

# ── OpenRouter (Meta Llama via OpenRouter aggregation API) ────────────────────
# Required when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional — defaults to meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Optional — used as HTTP-Referer and X-Title headers
OPENROUTER_SITE_URL=https://the-mirror-gules.vercel.app
OPENROUTER_SITE_NAME=THE MIRROR

# ── xAI / Grok ───────────────────────────────────────────────────────────────
# Required when AI_PROVIDER=xai
XAI_API_KEY=your-xai-api-key-here
# Optional — defaults to grok-beta
XAI_MODEL=grok-beta

# ── Local Ollama (development only) ──────────────────────────────────────────
# Required when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:latest
# Optional bearer token for hosted Ollama
# OLLAMA_API_KEY=your-optional-bearer-token

# ── Local llama.cpp (development only) ───────────────────────────────────────
# Required when AI_PROVIDER=llamacpp
LLAMACPP_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (Production Overrides)
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-secure-random-secret-in-production
MIRROR_API_TOKEN=replace-with-a-secure-token-in-production
ADMIN_PASSWORD=replace-with-a-secure-admin-password
