# THE MIRROR Environment Configuration

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=./data/mirror.db

# ============================================================
# AI PROVIDER
# Default: ollama (no API key needed)
# Options: ollama | llamacpp | openai | anthropic | gemini
# ============================================================
AI_PROVIDER=ollama

# Ollama settings (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# llama.cpp settings (alternative local provider)
LLAMACPP_BASE_URL=http://localhost:8080

# Future providers (leave empty for Phase 1)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ============================================================
# SECURITY
# ============================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-before-deployment

# API token for external AI clients accessing /api/mirror/*
# Generate with: openssl rand -base64 32
MIRROR_API_TOKEN=change-this-mirror-api-token

# Admin password for the researcher dashboard
ADMIN_PASSWORD=mirror-admin

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=THE MIRROR
NODE_ENV=development
