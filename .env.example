# THE MIRROR — Local-only Ollama configuration
DATABASE_DIALECT=sqlite
DATABASE_URL=./data/mirror.db

# Production can use PostgreSQL for storage, but AI remains local Ollama.
# DATABASE_DIALECT=postgres
# DATABASE_URL=postgres://...

# AI: Ollama only. No cloud AI providers and no AI API keys.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:latest

# Authentication for Mirror's own HTTP endpoints, if enabled.
JWT_SECRET=replace-with-a-secure-random-secret
MIRROR_API_TOKEN=replace-with-a-secure-random-token
ADMIN_PASSWORD=replace-with-a-secure-admin-password
