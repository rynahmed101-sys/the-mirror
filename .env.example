# THE MIRROR — dual Ollama deployment
# LOCAL: free local inference
# CLOUD: hosted Ollama inference with the free account's included starter usage

DATABASE_DIALECT=sqlite
DATABASE_URL=./data/mirror.db

# For the Vercel/Neon online Mirror:
# DATABASE_DIALECT=postgres
# DATABASE_URL=postgres://...

# Choose exactly one runtime mode.
OLLAMA_MODE=local

# LOCAL MODE
# OLLAMA_BASE_URL=http://localhost:11434/api
# OLLAMA_DEFAULT_MODEL=llama3.2

# CLOUD MODE
# OLLAMA_BASE_URL=https://ollama.com/api
# OLLAMA_DEFAULT_MODEL=gpt-oss:20b-cloud
# OLLAMA_API_KEY=<keep this only in the server environment>

# Mirror's own authentication is separate from model-provider authentication.
JWT_SECRET=replace-with-a-secure-random-secret
MIRROR_API_TOKEN=replace-with-a-secure-random-token
ADMIN_PASSWORD=replace-with-a-secure-admin-password
