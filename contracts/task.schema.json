{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mirror Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "mission_id",
    "objective",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "mirror.task.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pending",
        "active",
        "blocked",
        "completed",
        "failed"
      ]
    },
    "specialist": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
