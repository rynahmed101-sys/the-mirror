{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mirror Mission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "mission",
    "objective",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "mirror.mission.v1"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "blocked",
        "completed",
        "waiting"
      ]
    },
    "capability_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
