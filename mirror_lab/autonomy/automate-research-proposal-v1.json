{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://automate.physics/schemas/automate-research-proposal-v1.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","authority","proposal_id","request_id","capability_id","source_revision","candidate_capability","evidence_refs","assumptions","risks","limitations","status"],
  "properties":{
    "schema_version":{"const":"mirror.research_proposal.v1"},
    "authority":{"const":"UNTRUSTED_RESEARCH_PROPOSAL"},
    "proposal_id":{"type":"string","pattern":"^proposal_[0-9a-f]{32}$"},
    "request_id":{"type":"string","minLength":8,"maxLength":128},
    "capability_id":{"type":"string","minLength":1,"maxLength":256},
    "source_revision":{"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},
    "candidate_capability":{"type":"object","required":["id","name","summary","prerequisites","dependencies"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"summary":{"type":"string"},"prerequisites":{"type":"array","items":{"type":"string"}},"dependencies":{"type":"array","items":{"type":"string"}}}},
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "assumptions":{"type":"array","items":{"type":"string"}},
    "risks":{"type":"array","items":{"type":"string"}},
    "limitations":{"type":"array","items":{"type":"string"}},
    "status":{"const":"CANDIDATE"}
  }
}