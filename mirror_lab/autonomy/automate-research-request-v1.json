{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://automate.physics/schemas/automate-research-request-v1.json",
  "title":"Automate Research Request (v1)","type":"object","additionalProperties":false,
  "required":["schema_version","request_id","objective","sources","limits"],
  "properties":{
    "schema_version":{"const":"automate.research_request.v1"},
    "request_id":{"type":"string","minLength":1,"maxLength":128},
    "objective":{"type":"string","minLength":1,"maxLength":4000},
    "sources":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"string","enum":["web","paper","github","database","dataset","local"]}},
    "limits":{"type":"object","additionalProperties":false,"required":["max_sources","max_bytes","timeout_ms"],
      "properties":{"max_sources":{"type":"integer","minimum":1,"maximum":50},"max_bytes":{"type":"integer","minimum":1024,"maximum":50000000},"timeout_ms":{"type":"integer","minimum":1000,"maximum":300000}}},
    "query":{"type":["string","null"],"maxLength":4000},
    "required_evidence":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":500}}
  }
}