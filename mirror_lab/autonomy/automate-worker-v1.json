{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automate.physics/schemas/automate-worker-v1.json",
  "title": "Automate Autonomous Worker Contract (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet"
  ],
  "properties": {
    "schema_version": {
      "const": "automate.worker.v1"
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "repository",
        "capability",
        "constraints",
        "instructions",
        "verification",
        "task"
      ],
      "properties": {
        "kind": {
          "const": "capability_implementation"
        },
        "request_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "full_name",
            "base_branch"
          ],
          "properties": {
            "full_name": {
              "type": "string",
              "minLength": 1
            },
            "base_branch": {
              "enum": ["main", "engine"]
            },
            "base_sha_claim": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "stage",
            "name",
            "dependencies"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "stage": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_path_prefixes",
            "forbidden_paths",
            "branch_prefix",
            "max_files",
            "allow_delete"
          ],
          "properties": {
            "allowed_path_prefixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbidden_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "branch_prefix": {
              "const": "feat/"
            },
            "max_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "allow_delete": {
              "const": false
            }
          }
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "notes"
          ],
          "properties": {
            "files": {
              "type": "array",
              "maxItems": 25,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha",
                  "content"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 100000
                  }
                }
              }
            },
            "notes": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "must_run_tests",
            "must_report_unresolved",
            "must_not_claim_certification",
            "test_targets"
          ],
          "properties": {
            "must_run_tests": {
              "const": true
            },
            "must_report_unresolved": {
              "const": true
            },
            "must_not_claim_certification": {
              "const": true
            },
            "test_targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^tests/"
              }
            }
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "ref",
            "summary",
            "requirements"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
